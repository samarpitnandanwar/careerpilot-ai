rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================================
    // Default: deny all
    // ============================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // Resume uploads: users/{uid}/resumes/{fileName}
    //
    // Server-side firebase-admin SDK bypasses these rules — these protect
    // against direct client-side Storage access.
    //
    // Users can only read/write their own resumes.
    // File type is validated server-side (PDF, DOCX).
    // File size is validated server-side.
    // ============================================================================
    match /users/{userId}/resumes/{fileName} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Additional size limit (20MB) as defense-in-depth
      // Server validates actual content type
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
