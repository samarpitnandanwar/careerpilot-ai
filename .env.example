# ============================================================================
# CareerPilot AI — Environment Variables
# ============================================================================
#
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file with real credentials.
#
# SETUP:
#   cp .env.example .env.local
#   # Fill in the Identity Platform values below.
#
# For server-side GCP authentication, use Application Default Credentials:
#   gcloud auth application-default login
#
# Do NOT create or commit a service-account JSON key file.
# ============================================================================

# ---------------------------------------------------------------------------
# GCP Project
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GCP_PROJECT_ID=careerpilot-ai-506813

# ---------------------------------------------------------------------------
# Identity Platform (client-side — browser-safe public config)
# ---------------------------------------------------------------------------
# These values are intentionally public. They are embedded in the client
# bundle and are NOT secrets. They are required for the Firebase client SDK
# to connect to Identity Platform.
#
# Get them from: GCP Console > Identity Platform > Settings > Your apps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-identity-platform-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=careerpilot-ai-506813.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerpilot-ai-506813
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careerpilot-ai-506813.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ---------------------------------------------------------------------------
# Server-side GCP — Application Default Credentials (ADC)
# ---------------------------------------------------------------------------
# In production (Cloud Run), ADC uses the runtime service account automatically:
#   careerpilot-runtime@careerpilot-ai-506813.iam.gserviceaccount.com
#
# For local development, run:
#   gcloud auth application-default login
#
# This stores credentials at the standard ADC location (~/.config/gcloud/).
# No environment variable needed.
#
# ONLY as a fallback for local testing (NEVER in production):
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# If ADC is unavailable, server-side operations will fail with a clear error.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cloud Storage
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RESUME_BUCKET=careerpilot-ai-506813-resumes

# ---------------------------------------------------------------------------
# Pub/Sub
# ---------------------------------------------------------------------------
PUBSUB_TOPIC=careerpilot-events
PUBSUB_SUBSCRIPTION=careerpilot-events-sub


# ============================================================================
# GCP IAM — Least-Privilege Roles for Runtime Service Account
# ============================================================================
#
# Service account: careerpilot-runtime@careerpilot-ai-506813.iam.gserviceaccount.com
#
# Current required roles:
#
#   Identity Platform token verification (server-side):
#     roles/firebaseauth.admin
#     (Needed for verifyIdToken() in firebase-admin)
#
# Future roles (do not grant until implemented):
#
#   Firestore:
#     roles/datastore.user
#
#   Cloud Storage (resume uploads):
#     roles/storage.objectAdmin
#     (More restrictive than roles/storage.admin)
#
#   Vertex AI Gemini:
#     roles/aiplatform.user
#
#   Pub/Sub:
#     roles/pubsub.publisher
#     (Only for the careerpilot-events topic)
#
# Do NOT grant:
#   - roles/firebase.admin (too broad — use roles/firebaseauth.admin)
#   - roles/owner or roles/editor
#   - roles/storage.admin (use objectAdmin instead)
# ============================================================================
