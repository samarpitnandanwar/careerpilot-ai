# ============================================================================
# CareerPilot AI — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file with real credentials.

# GCP Project
NEXT_PUBLIC_GCP_PROJECT_ID=careerpilot-ai-506813

# Firebase / Identity Platform (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=careerpilot-ai-506813.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerpilot-ai-506813
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careerpilot-ai-506813.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# GCP Server-side (use Application Default Credentials in production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cloud Storage
NEXT_PUBLIC_RESUME_BUCKET=careerpilot-ai-506813-resumes

# Pub/Sub
PUBSUB_TOPIC=careerpilot-events
PUBSUB_SUBSCRIPTION=careerpilot-events-sub
