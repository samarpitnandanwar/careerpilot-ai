# ============================================================================
# CareerPilot AI — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file with real credentials.

# ---------------------------------------------------------------------------
# GCP Project
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GCP_PROJECT_ID=careerpilot-ai-506813

# ---------------------------------------------------------------------------
# Identity Platform (client-side — Firebase-compatible SDK config)
# These are PUBLIC config values, not secrets.
# Get them from: GCP Console > Identity Platform > Settings > Your apps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-identity-platform-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=careerpilot-ai-506813.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerpilot-ai-506813
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careerpilot-ai-506813.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ---------------------------------------------------------------------------
# Server-side GCP (Application Default Credentials)
# ---------------------------------------------------------------------------
# In production (Cloud Run), ADC uses the runtime service account automatically.
# For local development, set this to point to a service-account JSON:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# NEVER commit this file.

# ---------------------------------------------------------------------------
# Cloud Storage
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RESUME_BUCKET=careerpilot-ai-506813-resumes

# ---------------------------------------------------------------------------
# Pub/Sub
# ---------------------------------------------------------------------------
PUBSUB_TOPIC=careerpilot-events
PUBSUB_SUBSCRIPTION=careerpilot-events-sub
